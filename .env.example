# Copy to .env.local for development. Never commit real secrets.

# --- Application -----------------------------------------------------------
# Public base URL of this deployment (no trailing slash).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL) -------------------------------------------------
# Development default matches docker-compose.yml. Use your managed Postgres
# connection string in production.
DATABASE_URL=postgres://lms:lms_local_dev@127.0.0.1:5544/lms_dev

# --- Authentication (Better Auth) ------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Require users to confirm their email address before signing in.
# Needs a working email provider below. Recommended "true" in production.
REQUIRE_EMAIL_VERIFICATION=false

# --- Email (SMTP) ----------------------------------------------------------
# Leave SMTP_HOST empty to log emails to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="CGS Academy <no-reply@example.com>"

# --- File storage ----------------------------------------------------------
# "local" writes to STORAGE_LOCAL_DIR (development only; not durable on
# serverless hosts). "s3" uses any S3-compatible private bucket.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Branding --------------------------------------------------------------
# Official Cypher Green Systems website. Leave empty until confirmed; the
# footer then shows the attribution as plain text. Can also be set in
# Admin > Settings, which takes precedence.
CGS_WEBSITE_URL=

# --- Payments --------------------------------------------------------------
# "disabled" (default): paid courses cannot be purchased.
# "mpesa": Safaricom Daraja STK Push (requires the MPESA_* values).
# "sandbox": clearly-labelled test provider. Refused when NODE_ENV=production.
PAYMENT_PROVIDER=disabled
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Random secret embedded in the callback URL registered with Daraja.
MPESA_CALLBACK_SECRET=

# --- Operations ------------------------------------------------------------
# Optional bearer token that unlocks detailed output from /api/health.
HEALTHCHECK_TOKEN=
