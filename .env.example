# ===== EDVORA environment configuration (copy to .env.local / Vercel env) =====
# Never commit real secrets. Server-only values must NOT use NEXT_PUBLIC_.

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=

# One-time platform bootstrap (server-only; consumed at first initialisation)
OWNER_EMAIL=
OWNER_SETUP_SECRET=

# Supabase (production database / auth / storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DATABASE_URL=

# M-Pesa Daraja (server-only)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.co.ke/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Email delivery (verification codes, notifications)
RESEND_API_KEY=
EMAIL_FROM=EDVORA <edvoraplatform@gmail.com>

# AI study assistant (optional — retrieval fallback works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
