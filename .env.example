# ===== EDVORA environment configuration (copy to .env.local / Vercel env) =====
# Never commit real secrets. Server-only values must NOT use NEXT_PUBLIC_.

# Session signing secret (generate: openssl rand -hex 32)
SESSION_SECRET=

# One-time platform bootstrap (server-only; consumed at first initialisation)
OWNER_EMAIL=
OWNER_SETUP_SECRET=

# Supabase (production database / auth / storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# REQUIRED for durable accounts on Vercel: paste Supabase's
# *Transaction pooler* connection string (port 6543) here — the one
# labelled for serverless/edge apps. Do not use the direct/session
# (port 5432) string for the deployed Next.js app. On first use the app
# creates edvora_private.edvora_app_state automatically. DATABASE_URL is also
# accepted as an alias. Without this, the app falls back to temporary
# server storage and accounts may not survive cold starts.
SUPABASE_DATABASE_URL=
DATABASE_URL=
# Optional local/self-hosted JSON data directory (not needed on Vercel)
EDVORA_DATA_DIR=

# M-Pesa Daraja (server-only)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=https://your-domain.co.ke/api/payments/mpesa/callback
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline

# Email delivery (verification codes, notifications)
# REQUIRED in production so registration codes are actually emailed.
# For temporary launch testing only, set ALLOW_REGISTRATION_CODE_DISPLAY=true
# to show the code on the registration page; remove it for real learners.
RESEND_API_KEY=
EMAIL_FROM=EDVORA <edvoraplatform@gmail.com>
ALLOW_REGISTRATION_CODE_DISPLAY=false

# AI study assistant (optional — retrieval fallback works without it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
